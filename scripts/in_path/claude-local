#!/bin/bash
export CLAUDE_CONFIG_DIR="$HOME/.claude-local"
export ANTHROPIC_BASE_URL=http://localhost:11434
export ANTHROPIC_AUTH_TOKEN=ollama ANTHROPIC_API_KEY=
export ANTHROPIC_MODEL=mimo-v2.6:latest
export ANTHROPIC_DEFAULT_OPUS_MODEL=$ANTHROPIC_MODEL
export ANTHROPIC_DEFAULT_SONNET_MODEL=$ANTHROPIC_MODEL
export ANTHROPIC_DEFAULT_HAIKU_MODEL=$ANTHROPIC_MODEL
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=32768
# Without this cap, a 32k window auto-compacts after about two tool calls.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
exec claude --tools Bash,Read,Edit,Write,Glob,Grep,Skill --strict-mcp-config "$@"

